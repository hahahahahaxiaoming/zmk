#define ZMK_BEHAVIORS_KEEP_ALL

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/backlight.h> // 必须包含这个头灯

/ {
    keymap {
        compatible = "zmk,keymap";
    // 第 0 层：基础层
        default_layer {
            // ------------------------------------------------------------------------------------------
            // | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BSPC   |
            // | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   "|"   |
            // | CAPS  |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER    |
            // |  SHIFT  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |      SHIFT       |
            // |  CTL  |  WIN  |  ALT  |            SPACE              |  ALT  |  MENU |  CTL |  MO(1)  |
            // ------------------------------------------------------------------------------------------
            bindings = <
                &gresc    &kp N1   &kp N2   &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q    &kp W    &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I     &kp O    &kp P    &kp LBKT  &kp RBKT  &kp DEL 
                &kp CLCK  &kp A    &kp S    &kp D  &kp F  &kp G  &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT             &kp RET
                &kp LSHFT &kp Z    &kp X    &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH                     &kp RSHFT
                &kp LCTRL &kp LGUI &kp LALT             &kp SPACE                        &kp RALT &kp K_APP          &kp RCTRL &mo 1
            >;
        };

        // 第 1 层：Fn 功能层
        fn_layer {
            // ------------------------------------------------------------------------------------------------
            // |  ` ~   |  F1  |  F2  |  F3  |  F4  |  F5  |  F6  |  F7  |  F8  |  F9  |  F10 |  F11 |  F12 | SOFT OFF |
            // | BT CLR |      |  UP  |      | PREV | VOL+ | BRI+ |PSCRN | SLCK |PAUSE |      |      |      | "|"      |
            // | BTSEL0 | LEFT | DOWN | RIGHT| NEXT | VOL- | BRI- | INS  | HOME | PGUP |      |      |      | BOOTLOAD |
            // | BTSEL1 | BTSEL2| BTSEL3| BTSEL4| PLAY | MUTE |      | DEL  | END  | PGDN |  UP  |      |      | UNLOCK   |
            // |        |      |      |             BACKLIGHT CYCLE                | LEFT | DOWN | RIGHT|      |
            // ------------------------------------------------------------------------------------------------
            bindings = <
                &kp GRAVE    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5     &kp F6       &kp F7    &kp F8   &kp F9          &kp F10 &kp F11    &kp F12    &soft_off
                &bt BT_CLR   &trans       &kp UP       &trans       &kp C_PREV   &kp C_VOL_UP &kp C_BRI_UP &kp PSCRN &kp SLCK &kp PAUSE_BREAK &trans  &bl BL_DEC &bl BL_INC &kp BSLH
                &bt BT_SEL 0 &kp LEFT     &kp DOWN     &kp RIGHT    &kp C_NEXT   &kp C_VOL_DN &kp C_BRI_DN &kp INS   &kp HOME &kp PG_UP       &trans  &trans                &bootloader
                &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp C_PP     &kp C_MUTE   &trans       &kp DEL   &kp END  &kp PG_DN       &kp UP                        &studio_unlock
                &trans       &trans       &trans                                 &bl BL_TOG                                 &kp LEFT        &kp DOWN           &kp RIGHT  &trans
            >;
        };
    };
};
